diff --git a/tests/test_nested_counted.py b/tests/test_nested_counted.py
new file mode 100644
index 0000000..5c1b55a
--- /dev/null
+++ b/tests/test_nested_counted.py
@@ -0,0 +1,66 @@
+"""Regression for a static nested loop whose initial counter is a capture.
+
+The lowering hoists that constant out of the enclosing loop body. MLX replaces
+all body arguments, including the hoisted constant, with tracers. Reading the
+counter with item_int therefore retires the enclosing compiled body. A numerical
+check alone passes on the broken backend because it silently replays eagerly.
+"""
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.parametrize('start,stop', [(0, 3), (2, 5), (5, 5), (5, 2)])
+def test_nested_static_loop_compiles_and_differentiates(start, stop):
+    code = f'''
+import jax
+import jax.numpy as jnp
+import numpy as np
+from helpers import check
+
+def f(x, w):
+    def outer(i, h):
+        return jax.lax.fori_loop({start}, {stop},
+            lambda j, a: jnp.tanh(a @ w + a * 0.99 + j * 0.0001), h)
+    return jax.lax.fori_loop(0, 65, outer, x)
+
+x = np.random.default_rng(4).normal(size=(4, 4)).astype(np.float32) * 0.03
+w = np.eye(4, dtype=np.float32) * 0.002
+for scale in (1.0, 1.5):
+    check(f, x * scale, w, rtol=1e-4, atol=1e-5)
+    check(jax.grad(lambda a, b: jnp.sum(f(a, b)), argnums=(0, 1)),
+          x * scale, w, rtol=1e-4, atol=1e-5)
+print('nested forward and gradients match CPU')
+'''
+    env = dict(os.environ, METALJAX_DEBUG='1', METALJAX_MSL='0',
+               JAX_PLATFORMS='metal,cpu')
+    env['PYTHONPATH'] = str(Path(__file__).resolve().parent)
+    result = subprocess.run([sys.executable, '-c', code], env=env,
+                            text=True, capture_output=True, timeout=120)
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert 'compiled while body failed' not in result.stderr, result.stderr
+    assert 'chunked loop failed' not in result.stderr, result.stderr
+    drops = re.findall(r'drops=(\d+)/(\d+)', result.stderr)
+    assert drops and all(a == b == '0' for a, b in drops), result.stderr
+    if stop > start:
+        assert any(int(n) > 0 for n in re.findall(r'unrolls=(\d+)', result.stderr)), result.stderr
+
+
+def test_dynamic_start_and_bound_stay_dynamic():
+    # A runtime trip count must not be replaced by metadata from an earlier
+    # invocation. This also exercises nonzero starts and both zero-trip cases.
+    from helpers import check
+    import jax
+    import jax.numpy as jnp
+    import numpy as np
+
+    def f(x, start, stop):
+        return jax.lax.fori_loop(start, stop, lambda i, a: a * 1.01 + i, x)
+
+    for start, stop in [(0, 3), (2, 5), (5, 5), (5, 2)]:
+        check(f, np.ones(4, np.float32), np.int32(start), np.int32(stop),
+              rtol=1e-4, atol=1e-5)
