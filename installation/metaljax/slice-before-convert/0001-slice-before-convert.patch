+def test_raw_bits_values_gradients_and_donated_lifetimes(comparisons):
+    with np.load(comparisons[0][0]) as a, np.load(comparisons[1][0]) as b:
+        assert a.files == b.files
+        for key in a.files:
+            assert a[key].shape == b[key].shape and a[key].dtype == b[key].dtype, key
+            assert a[key].tobytes() == b[key].tobytes(), key
+
+
+def test_positive_and_negative_admission(comparisons):
+    metadata = json.loads(comparisons[1][0].with_suffix('.json').read_text())
+    segments = dict(re.findall(r'FBC_SLICE_CASE (\S+)\n(.*?)(?=FBC_SLICE_CASE |\Z)',
+                               comparisons[1][1], re.S))
+    for row in metadata:
+        counts = re.findall(r'slice-before-convert: conversions=(\d+)', segments[row['name']])
+        assert counts, row['name']
+        assert (sum(map(int, counts)) > 0) == row['admitted'], (row, segments[row['name']])
+    assert sum(map(int, re.findall(r'slice-before-convert: conversions=(\d+)', segments['gradients']))) > 0
+    assert sum(map(int, re.findall(r'helpers=(\d+)', segments['called']))) > 0
+    assert sum(map(int, re.findall(r'helpers=(\d+)', segments['shared_helper']))) > 0
+    assert 'slice-before-convert:' not in comparisons[0][1]
+
