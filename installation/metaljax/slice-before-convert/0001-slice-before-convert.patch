+        ('helper_nested', lambda a, i: nested_index_helper(a.astype(jnp.bfloat16), i), x, False),
+        ('helper_arithmetic', lambda a, i: arithmetic_helper(a.astype(jnp.bfloat16), i), x, False),
+        ('helper_vector', lambda a, i: vector_helper(a.astype(jnp.bfloat16), i.reshape(1)), x, False),
+        ('edges', dynamic, edge, True),
+        ('static_contiguous', lambda a, i: a.astype(jnp.bfloat16)[1:3], x, True),
+        ('static_strided', lambda a, i: a.astype(jnp.bfloat16)[1:5:2, ::2, 1:8:3], x, False),
+        ('multiple', multiple, x, True),
+        ('layout', layout, x, False),
+        ('layout_dot', lambda a, i: lax.dynamic_slice(
+            jnp.transpose(a, (1, 0, 2)).astype(jnp.bfloat16),
+            (i, 1, 2), (2, 3, 4)).reshape(6, 4) @
+            jnp.asarray(rng.normal(size=(4, 13)).astype(np.float32), jnp.bfloat16), x, False),
+        ('two_dynamic_axes', lambda a, i: lax.dynamic_slice(a.astype(jnp.bfloat16),
+            (i, i, 0), (1, 3, 11), allow_negative_indices=False), x, True),
+        ('other_shape', lambda a, i: lax.dynamic_slice(a.astype(jnp.bfloat16), (i, 0), (3, 5)),
+         rng.normal(size=(13, 5)).astype(np.float32), True),
+        ('escaped', escaped, x, False),
+        ('cross_region', cross_region, x, False),
+        ('empty', lambda a, i: a.astype(jnp.bfloat16)[:, :3],
+         np.empty((0, 7), np.float32), False),
+        ('dynamic_loop', lambda a, i: lax.fori_loop(0, i,
+            lambda n, v: v + lax.dynamic_slice(a.astype(jnp.bfloat16),
+                (n, 0, 0), (1, 9, 11)), jnp.zeros((1, 9, 11), jnp.bfloat16)), x, True),
+        ('no_reduction', lambda a, i: a.astype(jnp.bfloat16)[:, :, :], x, False),
+        ('aggregate_full', aggregate_full, x, False),
+        ('reshape', reshape, x, False),
+        ('fp16', lambda a, i: a.astype(jnp.float16)[1:2], x, False),
+        ('bf16_f32', lambda a, i: a.astype(jnp.float32)[1:2], x.astype(jnp.bfloat16), False),
+    ]
+    for name, fn, a, admitted in cases:
+        print('FBC_SLICE_CASE ' + name, file=sys.stderr, flush=True)
+        jax.clear_caches()  # admission must be observed separately for every fixture
+        compiled = jax.jit(fn).lower(a, np.int32(0)).compile()
+        # The backend's OptimizedProgram contains the transformed StableHLO.
+        (destination.parent / (name + '-optimized.txt')).write_text(compiled.as_text())
+        for index, i in enumerate([-100, -1, 0, 3, 6, 100]):
+            for leaf, value in enumerate(jax.tree_util.tree_leaves(compiled(a, np.int32(i)))):
+                if value.dtype == jnp.bfloat16:
+                    value = lax.bitcast_convert_type(value, jnp.uint16)
+                saved[f'{name}_{index}_{leaf}'] = np.asarray(value)
+        metadata.append(dict(name=name, admitted=admitted))
+
+    print('FBC_SLICE_CASE gradients', file=sys.stderr, flush=True)
+    def loss(a):
+        def body(i, acc):
+            y = jax.checkpoint(dynamic)(a, i).astype(jnp.float32)
+            return acc + jnp.sum(jnp.tanh(y * .03))
+        return lax.fori_loop(0, 7, body, jnp.float32(0))
+    direct_grad = jax.jit(jax.value_and_grad(lambda a, i:
+        jnp.sum(jnp.tanh(jax.checkpoint(dynamic)(a, i).astype(jnp.float32) * .03))))
+    for index, i in enumerate([-100, 0, 3, 100]):
+        for n, v in enumerate(jax.tree_util.tree_leaves(direct_grad(x, np.int32(i)))):
+            saved[f'direct_gradient_{index}_{n}'] = np.asarray(v)
+    called_grad = jax.jit(jax.value_and_grad(lambda a, i:
+        jnp.sum(jnp.tanh(jax.checkpoint(index_helper)(a.astype(jnp.bfloat16), i).astype(jnp.float32) * .03))))
+    for index, i in enumerate([-100, 0, 3, 100]):
+        for n, v in enumerate(jax.tree_util.tree_leaves(called_grad(x, np.int32(i)))):
+            saved[f'called_gradient_{index}_{n}'] = np.asarray(v)
+    grad = jax.jit(jax.value_and_grad(loss))
+    for i, a in enumerate([x, x * .7 + .01]):
+        for n, v in enumerate(jax.tree_util.tree_leaves(grad(a))):
+            saved[f'gradient_{i}_{n}'] = np.asarray(v)
+
+    print('FBC_SLICE_CASE donation', file=sys.stderr, flush=True)
+    donate = jax.jit(lambda a, i: (dynamic(a, i), a + jnp.float32(1)), donate_argnums=(0,))
+    retained = []
+    for i in range(12):
+        a = jax.device_put(x * (i + 1))
+        result, updated = donate(a, np.int32(i % 7))
+        np.testing.assert_array_equal(np.asarray(updated), x * (i + 1) + 1)
+        assert a.is_deleted()
+        retained.append(result)
+    for i, value in enumerate(retained):
+        saved[f'donated_{i}'] = np.asarray(lax.bitcast_convert_type(value, jnp.uint16))
+    np.savez(destination, **saved)
+    destination.with_suffix('.json').write_text(json.dumps(metadata))
+
