+@pytest.mark.parametrize('budget', ['METALJAX_MEM_BUDGET_MB', 'METALJAX_MEM_SYS_MB'])
+def test_governor_still_refuses_with_rewrite(budget):
+    code = """
+import jax, jax.numpy as jnp, numpy as np
+try:
+    x = jax.device_put(np.arange(1 << 20, dtype=np.float32).reshape(16, 65536))
+    out = jax.jit(lambda a: a.astype(jnp.bfloat16)[1:2])(x)
+    np.asarray(out)
+except Exception as e:
+    print(type(e).__name__ + ': ' + str(e))
+else:
+    raise AssertionError('governor admitted an impossible budget')
+"""
+    for mode in ['0', '1']:
+        env = dict(os.environ, JAX_PLATFORMS='metal', METALJAX_SLICE_BEFORE_CONVERT=mode,
+                   METALJAX_MEM_STALL_MS='0', METALJAX_MEM_SAMPLE_US='0')
+        env[budget] = '1'
+        result = subprocess.run([sys.executable, '-c', code], env=env,
+                                capture_output=True, text=True, timeout=60)
+        assert result.returncode == 0, result.stderr
+        assert 'RESOURCE_EXHAUSTED' in result.stdout, result.stdout + result.stderr
+        assert budget in result.stdout, result.stdout
+
