+// The frozen runtime emits astype for conversion, a view for static slice,
+// and a materializing slice for an ordinary runtime-index dynamic slice.
+// Let N be the full source, T the sum of static-window elements, and D the
+// sum of dynamic-window elements, counting EVERY admitted use. Logical bytes
+// before: 6N + 4D; after: 6T + 14D (8D FP32 slice + 6D conversion).
+// Strict savings therefore require 3T + 5D < 3N. This is an access-cost bound,
+// not a hardware timing promise. Position specialization can remove a dynamic
+// copy, but we deliberately do not depend on it when admitting a conversion.
+class SliceBeforeConvertBudget {
+ public:
+  constexpr explicit SliceBeforeConvertBudget(int64_t full)
+      : remaining_(full > 0 && full <= std::numeric_limits<int64_t>::max() / 3
+                       ? 3 * full : 0) {}
+  constexpr bool Spend(int64_t elements, bool materializes) {
+    const int64_t weight = materializes ? 5 : 3;
+    // Reserve strict positive savings, and check division BEFORE multiplying.
+    // An unrepresentable full budget or aggregate cost preserves old lowering.
+    if (remaining_ <= 0 || elements <= 0 || elements > (remaining_ - 1) / weight)
+      return false;
+    remaining_ -= elements * weight;
+    return true;
+  }
+ private:
+  int64_t remaining_;
+};
+
+// Exercise the same arithmetic at build time without allocating giant arrays.
+static_assert([] { SliceBeforeConvertBudget b(5); return b.Spend(2, true); }());
+static_assert([] { SliceBeforeConvertBudget b(5); return !b.Spend(3, true); }());
+static_assert([] { SliceBeforeConvertBudget b(10); return b.Spend(3, true) &&
+    b.Spend(4, false) && !b.Spend(1, false); }());
+static_assert([] { SliceBeforeConvertBudget b(std::numeric_limits<int64_t>::max());
+    return !b.Spend(1, false); }());
+static_assert([] { SliceBeforeConvertBudget b(std::numeric_limits<int64_t>::max() / 3);
+    return b.Spend(1, true) && !b.Spend(std::numeric_limits<int64_t>::max(), true); }());
+
+// Commute only shape-preserving, elementwise f32 -> bf16 conversion with
+// reducing, row-contiguous windows of proven row-contiguous sources. All uses
+// must be admitted together with strict aggregate logical access savings.
+// No buffers or values survive a call. The ordinary slice/convert handlers
+// still define indexing, clamping, layout handling and BF16 rounding.
+void SliceBeforeConvert(mlir::ModuleOp module) {
+  const char* enabled = std::getenv("METALJAX_SLICE_BEFORE_CONVERT");
+  if (enabled == nullptr || std::string(enabled) != "1") return;
+  auto count = [](mlir::RankedTensorType t) -> int64_t {
+    if (!t || !t.hasStaticShape() || t.getEncoding()) return 0;
+    int64_t n = 1;
+    for (int64_t d : t.getShape()) {
+      if (d <= 0 || n > std::numeric_limits<int64_t>::max() / d) return 0;
+      n *= d;
+    }
+    return n;
+  };
+  // PJRT inputs are dense row-major: BufferFromHostBuffer gathers host strides,
+  // and RunOnce materializes every non-row-contiguous result before publishing
+  // a MetalBuffer. Prove that this source still has that layout, following only
+  // reshapes, optimization barriers, function arguments with ALL callers proven,
+  // and invariant while carries. A transpose/broadcast/slice/computed source or unknown caller is
+  // deliberately not a proof. BF16 reductions can change rounding if a moved
+  // conversion materializes a formerly strided view in a different layout.
+  auto symbol_uses = mlir::SymbolTable::getSymbolUses(&module->getRegion(0));
+  if (!symbol_uses) return;  // unknown symbol scopes are not a closed caller set
+  llvm::DenseMap<mlir::Operation*, std::vector<mlir::func::CallOp>> callers;
+  llvm::DenseSet<mlir::Operation*> unknown_callers;
+  for (const auto& use : *symbol_uses) {
+    auto ref = mlir::dyn_cast<mlir::FlatSymbolRefAttr>(use.getSymbolRef());
+    if (!ref) return;
+    auto fn = module.lookupSymbol<mlir::func::FuncOp>(ref.getValue());
+    if (!fn) continue;
+    auto call = mlir::dyn_cast<mlir::func::CallOp>(use.getUser());
+    if (!call || call.getCallee() != fn.getSymName())
+      unknown_callers.insert(fn.getOperation());
+    else
+      callers[fn.getOperation()].push_back(call);
+  }
+  llvm::DenseMap<mlir::Value, int> row_state;
+  std::function<bool(mlir::Value)> row_source = [&](mlir::Value value) {
+    auto found = row_state.find(value);
+    if (found != row_state.end()) return found->second == 2;
+    row_state[value] = 1;  // visiting: recursive/unknown provenance declines
+    bool row = false;
+    if (auto arg = mlir::dyn_cast<mlir::BlockArgument>(value)) {
+      mlir::Block* block = arg.getOwner();
+      const unsigned index = arg.getArgNumber();
+      if (auto fn = mlir::dyn_cast<mlir::func::FuncOp>(block->getParentOp())) {
+        if (fn.getBody().getBlocks().size() == 1) {
+          if (fn.getSymName() == "main") {
+            row = callers[fn.getOperation()].empty() &&
+                  !unknown_callers.contains(fn.getOperation());
+          } else {
+            const auto& sites = callers[fn.getOperation()];
+            row = !sites.empty() && !unknown_callers.contains(fn.getOperation());
+            for (auto call : sites)
+              if (index >= call.getNumOperands() || !row_source(call.getOperand(index))) row = false;
+          }
+        }
+      } else if (auto loop = mlir::dyn_cast<mlir::stablehlo::WhileOp>(block->getParentOp())) {
+        if (loop.getBody().hasOneBlock() && index < loop.getNumOperands()) {
+          mlir::Block& body = loop.getBody().front();
+          mlir::Operation* ret = body.getTerminator();
+          if (index < body.getNumArguments() && index < ret->getNumOperands() &&
+              ret->getOperand(index) == body.getArgument(index))
+            row = row_source(loop->getOperand(index));
+        }
+      }
+    } else if (auto reshape = value.getDefiningOp<mlir::stablehlo::ReshapeOp>()) {
+      row = row_source(reshape.getOperand());
+    } else if (auto barrier = value.getDefiningOp<mlir::stablehlo::OptimizationBarrierOp>()) {
+      // The existing lowering aliases each result to its corresponding operand
+      // slot; this operation neither computes nor materializes a different view.
+      auto result = mlir::cast<mlir::OpResult>(value);
+      const unsigned index = result.getResultNumber();
+      if (barrier->getNumResults() == barrier->getNumOperands() &&
+          index < barrier->getNumOperands())
+        row = row_source(barrier->getOperand(index));
+    }
+    row_state[value] = row ? 2 : 3;
+    return row;
+  };
+  // JAX frequently puts dynamic_slice -> reshape in a small func.call.
+  // Prove that helper structurally, without names or layer-count assumptions.
+  // Inline only an admitted call site; other callers and the callee are intact.
+  auto helper_slice = [&](mlir::Operation* user, unsigned arg) -> mlir::Operation* {
+    auto call = mlir::dyn_cast<mlir::func::CallOp>(user);
+    if (!call || call.getNumResults() != 1) return nullptr;
+    auto fn = module.lookupSymbol<mlir::func::FuncOp>(call.getCallee());
+    if (!fn || fn.getBody().getBlocks().size() != 1 ||
+        fn.getNumArguments() != call.getNumOperands() || arg >= fn.getNumArguments())
+      return nullptr;
+    mlir::Block& body = fn.getBody().front();
+    auto ret = mlir::dyn_cast<mlir::func::ReturnOp>(body.getTerminator());
+    if (!ret || ret.getNumOperands() != 1) return nullptr;
+    mlir::Value result = ret.getOperand(0);
+    llvm::DenseSet<mlir::Operation*> reshapes;
+    while (auto reshape = result.getDefiningOp<mlir::stablehlo::ReshapeOp>()) {
+      if (!result.hasOneUse()) return nullptr;
+      reshapes.insert(reshape.getOperation());
+      result = reshape.getOperand();
+    }
+    mlir::Operation* slice = result.getDefiningOp();
+    if (!slice || !mlir::isa<mlir::stablehlo::SliceOp,
+                            mlir::stablehlo::DynamicSliceOp>(slice) ||
+        slice->getOperand(0) != body.getArgument(arg) ||
+        !body.getArgument(arg).hasOneUse() || !result.hasOneUse()) return nullptr;
+    const int64_t n = count(mlir::dyn_cast<mlir::RankedTensorType>(result.getType()));
+    if (!n) return nullptr;
+    for (mlir::Operation* reshape : reshapes)
+      if (count(mlir::dyn_cast<mlir::RankedTensorType>(reshape->getResult(0).getType())) != n)
+        return nullptr;
+    auto scalar_integer = [](mlir::Value v) {
+      auto t = mlir::dyn_cast<mlir::RankedTensorType>(v.getType());
+      return t && t.getRank() == 0 && !t.getEncoding() &&
+             mlir::isa<mlir::IntegerType>(t.getElementType());
+    };
+    for (unsigned i = 0; i < body.getNumArguments(); ++i)
+      if (i != arg && !scalar_integer(body.getArgument(i))) return nullptr;
+    for (mlir::Operation& op : body) {
+      if (&op == slice || &op == ret.getOperation() || reshapes.contains(&op)) continue;
+      auto name = op.getName().getStringRef();
+      if (op.getNumRegions() != 0 ||
+          (name != "stablehlo.constant" && name != "stablehlo.add" &&
+           name != "stablehlo.subtract" && name != "stablehlo.compare" &&
+           name != "stablehlo.select" && name != "stablehlo.minimum" &&
+           name != "stablehlo.maximum" && name != "stablehlo.convert")) return nullptr;
+      for (mlir::Value v : op.getOperands()) if (!scalar_integer(v)) return nullptr;
+      for (mlir::Value v : op.getResults()) if (!scalar_integer(v)) return nullptr;
+    }
+    return slice;
+  };
+  std::vector<mlir::stablehlo::ConvertOp> candidates;
+  module.walk([&](mlir::stablehlo::ConvertOp op) { candidates.push_back(op); });
+  int64_t conversions = 0, slices = 0, helpers = 0;
+  for (auto cv : candidates) {
+    auto src = mlir::dyn_cast<mlir::RankedTensorType>(cv.getOperand().getType());
+    auto dst = mlir::dyn_cast<mlir::RankedTensorType>(cv.getResult().getType());
+    const int64_t full = count(src);
+    if (!full || !dst || !count(dst) || !src.getElementType().isF32() ||
+        !dst.getElementType().isBF16() || src.getShape() != dst.getShape() ||
+        cv.getResult().use_empty() || !row_source(cv.getOperand())) continue;
+    std::vector<mlir::Operation*> users;
+    std::vector<mlir::Operation*> calls;
+    SliceBeforeConvertBudget budget(full);
+    bool eligible = true;
+    for (mlir::OpOperand& use : cv.getResult().getUses()) {
+      mlir::Operation* user = use.getOwner();
+      mlir::Operation* selection = user;
+      if (mlir::isa<mlir::func::CallOp>(user)) {
+        selection = helper_slice(user, use.getOperandNumber());
+        calls.push_back(user);
+      } else if (use.getOperandNumber() != 0) selection = nullptr;
+      if (user->getBlock() != cv->getBlock() || !selection ||
+          !mlir::isa<mlir::stablehlo::SliceOp,
+                     mlir::stablehlo::DynamicSliceOp>(selection) ||
+          selection->getNumResults() != 1) {
+        eligible = false;
+        break;
+      }
+      auto out = mlir::dyn_cast<mlir::RankedTensorType>(selection->getResult(0).getType());
+      const int64_t n = count(out);
+      if (!n || out.getRank() != src.getRank() ||
+          out.getElementType() != dst.getElementType()) {
+        eligible = false;
+        break;
+      }
+      // A dynamic slice may become a static view in a position-specialized
+      // compiled loop. Require a row-contiguous window in either spelling:
+      // every axis preceding a shortened suffix must have extent one.
+      bool cut_suffix = false;
+      for (int64_t i = src.getRank(); i-- > 0;) {
+        if (cut_suffix && out.getDimSize(i) != 1) { eligible = false; break; }
+        if (out.getDimSize(i) != src.getDimSize(i)) cut_suffix = true;
+      }
+      if (!eligible) break;
+      // A static strided view could change downstream layout-sensitive
+      // reduction/matmul choices when materialized by the moved conversion.
+      // Admit only row-major contiguous windows; dynamic_slice already
+      // materializes its window through the unchanged runtime handler.
+      if (auto sl = mlir::dyn_cast<mlir::stablehlo::SliceOp>(selection)) {
+        for (int64_t i = src.getRank(); i-- > 0;) {
+          if (sl.getStrides()[i] != 1) {
+            eligible = false;
+            break;
+          }
+        }
+        if (!eligible) break;
+      }
+      if (!budget.Spend(n, mlir::isa<mlir::stablehlo::DynamicSliceOp>(selection))) {
+        eligible = false;
+        break;
+      }
+      users.push_back(user);
+    }
+    if (!eligible) continue;
+    for (mlir::Operation* user : calls) {
+      auto call = mlir::cast<mlir::func::CallOp>(user);
+      auto fn = module.lookupSymbol<mlir::func::FuncOp>(call.getCallee());
+      mlir::Block& body = fn.getBody().front();
+      mlir::IRMapping mapping;
+      for (unsigned i = 0; i < call.getNumOperands(); ++i)
+        mapping.map(body.getArgument(i), call.getOperand(i));
+      mlir::OpBuilder builder(user);
+      for (mlir::Operation& op : body.without_terminator()) builder.clone(op, mapping);
+      call.getResult(0).replaceAllUsesWith(mapping.lookup(body.getTerminator()->getOperand(0)));
+      call.erase();
+      ++helpers;
+    }
+    // Only the cloned slices now read the conversion; the callee stayed intact.
+    users.clear();
+    for (mlir::Operation* user : cv.getResult().getUsers()) users.push_back(user);
+    for (mlir::Operation* user : users) {
+      mlir::OpBuilder builder(user);
+      auto out = mlir::cast<mlir::RankedTensorType>(user->getResult(0).getType());
+      mlir::Operation* slice = builder.clone(*user);
+      slice->setOperand(0, cv.getOperand());
+      slice->getResult(0).setType(mlir::RankedTensorType::get(
+          out.getShape(), src.getElementType()));
+      mlir::Operation* convert = builder.clone(*cv.getOperation());
+      convert->setOperand(0, slice->getResult(0));
+      convert->getResult(0).setType(out);
+      user->getResult(0).replaceAllUsesWith(convert->getResult(0));
+      user->erase();
+      ++slices;
+    }
+    cv->erase();
+    ++conversions;
+  }
+  if (kDebug) {
+    std::fprintf(stderr, "[metaljax-native] slice-before-convert: "
+                         "conversions=%lld slices=%lld helpers=%lld\n",
+                 static_cast<long long>(conversions),
+                 static_cast<long long>(slices), static_cast<long long>(helpers));
+    std::fflush(stderr);
+  }
+}
