+// Optional CPU-only diagnostics. No GPU barriers or extra array references.
+bool ScheduleProfileActive() {
+  static const bool enabled = [] {
+    const char* v = std::getenv("FBC_SCHED_PROFILE");
+    return v && std::strcmp(v, "1") == 0;
+  }();
+  const char* phase = enabled ? std::getenv("FBC_PROFILE_ACTIVE") : nullptr;
+  return phase && phase[0] != '0';
+}
 
