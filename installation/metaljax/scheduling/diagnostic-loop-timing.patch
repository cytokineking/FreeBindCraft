   // Wait for the oldest submissions until at most `keep` are left.
   void keep_at_most(int64_t keep) {
     while (static_cast<int64_t>(ring_.size()) > keep) {
+      const bool profile = ScheduleProfileActive();
+      const int64_t start = profile ? timing_now_ns() : 0;
+      if (profile) {
+        for (const mx::array& a : ring_.front()) {
+          ++events_;
+          mx::array probe(mx::Shape{}, mx::bool_, nullptr, {});
+          probe.attach_event(a.event());
+          probe.set_status(mx::array::Status::evaluated);
+          if (!probe.is_available()) ++not_ready_;
+        }
+      }
       for (mx::array& a : ring_.front()) a.wait();
+      if (profile) {
+        const int64_t elapsed = timing_now_ns() - start;
+        wait_ns_ += elapsed;
+        max_wait_ns_ = std::max(max_wait_ns_, elapsed);
+      }
       ring_.pop_front();
       waits_++;
     }
+  }
