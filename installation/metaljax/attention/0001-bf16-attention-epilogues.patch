+// FreeBindCraft experimental BF16 Evoformer softmax forward/backward fusion.
+// Bias/mask/clip epilogues may fuse. Attention GEMMs and projections stay literal.
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "evo_attention.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/Support/raw_ostream.h"
+#include "metal/metal_recognize.h"
+#include "mlir/IR/BuiltinAttributes.h"
+#include "mlir/IR/BuiltinTypes.h"
+namespace metaljax {
+namespace {
+using MlirOp = mlir::Operation;
+std::string Name(MlirOp* o) {
+  return o ? o->getName().getStringRef().str() : "";
+}
+MlirOp* Owner(mlir::Value v) { return v ? v.getDefiningOp() : nullptr; }
+std::vector<int64_t> Shape(mlir::Value v) {
+  auto t = mlir::dyn_cast<mlir::RankedTensorType>(v.getType());
+  return t ? std::vector<int64_t>(t.getShape().begin(), t.getShape().end())
+           : std::vector<int64_t>();
+}
+bool BF(mlir::Value v) {
+  auto t = mlir::dyn_cast<mlir::RankedTensorType>(v.getType());
+  return t && t.getElementType().isBF16();
+}
+bool F32(mlir::Value v) {
+  auto t = mlir::dyn_cast<mlir::RankedTensorType>(v.getType());
+  return t && t.getElementType().isF32();
+}
+std::vector<int64_t> Attr(MlirOp* o, const char* k) {
+  auto a = o->getAttrOfType<mlir::DenseI64ArrayAttr>(k);
+  return a ? std::vector<int64_t>(a.asArrayRef().begin(), a.asArrayRef().end())
+           : std::vector<int64_t>();
+}
+bool Const(mlir::Value v, double expected) {
+  MlirOp* o = Owner(v);
+  if (!o) return false;
+  if (Name(o) == "stablehlo.broadcast_in_dim" || Name(o) == "stablehlo.reshape")
+    return Const(o->getOperand(0), expected);
+  if (Name(o) != "stablehlo.constant") return false;
+  auto a = o->getAttrOfType<mlir::DenseFPElementsAttr>("value");
+  return a && a.isSplat() &&
+         a.getSplatValue<llvm::APFloat>().convertToDouble() == expected;
+}
+bool View(MlirOp* o) {
+  auto n = Name(o);
+  if (n == "stablehlo.reshape") return true;
+  if (n != "stablehlo.broadcast_in_dim") return false;
+  auto ds = Attr(o, "broadcast_dimensions");
+  for (size_t i = 0; i < ds.size(); ++i)
+    if (ds[i] != (int64_t)i) return false;
+  return true;
+}
+mlir::Value Peel(mlir::Value v, std::vector<MlirOp*>& ops) {
+  while (MlirOp* o = Owner(v)) {
+    if (!View(o)) break;
+    ops.push_back(o);
+    v = o->getOperand(0);
+  }
+  return v;
+}
+bool Reduce(MlirOp* o, mlir::Value x, bool maximum) {
+  if (Name(o) != "stablehlo.reduce" || o->getNumOperands() != 2 ||
+      o->getNumResults() != 1 ||
+      Attr(o, "dimensions") != std::vector<int64_t>{3} || o->getOperand(0) != x)
+    return false;
+  if (!Const(o->getOperand(1), maximum ? -INFINITY : 0.0)) return false;
+  if (o->getNumRegions() != 1 || !o->getRegion(0).hasOneBlock()) return false;
+  auto& b = o->getRegion(0).front();
+  if (b.getOperations().size() != 2) return false;
+  MlirOp& r = b.front();
+  return Name(&r) == (maximum ? "stablehlo.maximum" : "stablehlo.add") &&
+         r.getOperand(0) == b.getArgument(0) &&
+         r.getOperand(1) == b.getArgument(1);
+}
+// Short rows use a different frozen MLX BF16 reduction order and decline.
+bool Geometry(mlir::Value v) {
+  auto s = Shape(v);
+  if (!BF(v) || s.size() != 4 || s[0] < 1 || (s[1] != 4 && s[1] != 8) ||
+      s[2] < 16 || s[3] < 65 || s[3] > 512)
+    return false;
+  int64_t n = 1;
+  for (auto d : s) {
+    if (d < 1) return false;
+    if (d > (1LL << 28) / n) return false;
+    n *= d;
+  }
+  return n <= (1LL << 28) && n / s.back() >= 32;
+}
+bool Escapes(EvoAttentionMatch& m) {
+  std::set<MlirOp*> own(m.ops.begin(), m.ops.end());
+  llvm::DenseSet<mlir::Value> ports(m.outputs.begin(), m.outputs.end());
+  for (MlirOp* o : own)
+    for (auto v : o->getResults())
+      for (MlirOp* u : v.getUsers())
+        if (!own.count(u)) {
+          if (!ports.count(v)) return true;
+          while (u && u->getBlock() != m.root->getBlock()) u = u->getParentOp();
+          if (!u || !m.root->isBeforeInBlock(u)) return true;
+        }
+  return false;
+}
+std::unique_ptr<EvoAttentionMatch> Forward(MlirOp* root) {
+  if (Name(root) != "stablehlo.divide" || !Geometry(root->getResult(0)))
+    return nullptr;
+  auto m = std::make_unique<EvoAttentionMatch>();
+  m->root = root;
+  m->kind = 0;
+  m->ops.push_back(root);
+  MlirOp* ex = Owner(root->getOperand(0));
+  if (Name(ex) != "stablehlo.exponential" || !BF(ex->getResult(0)))
+    return nullptr;
+  auto e = ex->getResult(0);
+  auto den = Peel(root->getOperand(1), m->ops);
+  MlirOp* dc = Owner(den);
+  if (Name(dc) != "stablehlo.convert" || !BF(den) || !F32(dc->getOperand(0)))
+    return nullptr;
+  auto rs = Shape(e);
+  rs.back() = 1;
+  if (Shape(den) != rs) return nullptr;
+  m->ops.push_back(dc);
+  auto sv = Peel(dc->getOperand(0), m->ops);
+  MlirOp* sum = Owner(sv);
+  if (Name(sum) != "stablehlo.reduce") return nullptr;
+  MlirOp* up = Owner(sum->getOperand(0));
+  if (Name(up) != "stablehlo.convert" || !F32(up->getResult(0)) ||
+      up->getOperand(0) != e || !Reduce(sum, up->getResult(0), false))
+    return nullptr;
+  MlirOp* sub = Owner(ex->getOperand(0));
+  if (Name(sub) != "stablehlo.subtract" || !BF(sub->getResult(0)))
+    return nullptr;
+  auto x = sub->getOperand(0);
+  if (Shape(x) != Shape(e) || !BF(x)) return nullptr;
+  auto mv = Peel(sub->getOperand(1), m->ops);
+  MlirOp* mx = Owner(mv);
+  if (Name(mx) == "stablehlo.maximum") {
+    if (Const(mx->getOperand(0), -INFINITY))
+      mv = mx->getOperand(1);
+    else if (Const(mx->getOperand(1), -INFINITY))
+      mv = mx->getOperand(0);
+    else
+      return nullptr;
+    m->ops.push_back(mx);
+    mx = Owner(mv);
+  }
+  if (!Reduce(mx, x, true)) return nullptr;
+  m->ops.insert(m->ops.end(), {ex, sum, up, sub, mx});
+  m->inputs = {x};
+  m->outputs = {root->getResult(0), e, den};
+  if (Escapes(*m)) return nullptr;
+  return m;
+}
+std::unique_ptr<EvoAttentionMatch> Backward(
+    MlirOp* root, const llvm::DenseMap<mlir::Value, mlir::Value>& fwd) {
+  if (Name(root) != "stablehlo.multiply" || !Geometry(root->getResult(0)))
+    return nullptr;
+  mlir::Value e, a;
+  for (int i = 0; i < 2; ++i)
+    if (fwd.count(root->getOperand(i))) {
+      e = root->getOperand(i);
+      a = root->getOperand(1 - i);
+      break;
+    }
+  if (!e) return nullptr;
+  MlirOp* add = Owner(a);
+  if (Name(add) != "stablehlo.add" || !BF(a)) return nullptr;
+  for (int side = 0; side < 2; ++side) {
+    auto m = std::make_unique<EvoAttentionMatch>();
+    m->root = root;
+    m->kind = 1;
+    m->ops = {root, add};
+    MlirOp* div = Owner(add->getOperand(side));
+    if (Name(div) != "stablehlo.divide") continue;
+    auto g = div->getOperand(0);
+    auto d = Peel(div->getOperand(1), m->ops);
+    if (d != fwd.lookup(e) || !BF(g) || Shape(g) != Shape(e)) continue;
+    m->ops.push_back(div);
+    auto nv = add->getOperand(1 - side);
+    MlirOp* neg = nullptr;
+    bool bad = false;
+    for (int depth = 0; depth < 12; ++depth) {
+      nv = Peel(nv, m->ops);
+      MlirOp* o = Owner(nv);
+      if (Name(o) == "stablehlo.negate") {
+        neg = o;
+        break;
+      }
+      if (Name(o) == "stablehlo.convert" &&
+          ((BF(nv) && F32(o->getOperand(0))) ||
+           (F32(nv) && BF(o->getOperand(0))))) {
+        m->ops.push_back(o);
+        nv = o->getOperand(0);
+        continue;
+      }
+      if (Name(o) == "stablehlo.reduce" && F32(nv) &&
+          Shape(o->getOperand(0)).size() == 4 &&
+          Shape(o->getOperand(0)).back() == 1 &&
+          Reduce(o, o->getOperand(0), false)) {
+        m->ops.push_back(o);
+        nv = o->getOperand(0);
+        continue;
+      }
+      bad = true;
+      break;
+    }
+    if (bad || !neg || !BF(neg->getResult(0))) continue;
+    m->ops.push_back(neg);
+    auto red = Peel(neg->getOperand(0), m->ops);
+    MlirOp* sum = Owner(red);
+    if (Name(sum) != "stablehlo.reduce" || !BF(red)) continue;
+    MlirOp* mul = Owner(sum->getOperand(0));
+    if (Name(mul) != "stablehlo.multiply") continue;
+    mlir::Value t;
+    if (mul->getOperand(0) == e)
+      t = mul->getOperand(1);
+    else if (mul->getOperand(1) == e)
+      t = mul->getOperand(0);
+    else
+      continue;
+    if (!Reduce(sum, mul->getResult(0), false)) continue;
+    MlirOp* gm = Owner(t);
+    if (Name(gm) != "stablehlo.multiply" || !BF(t)) continue;
+    mlir::Value rv;
+    if (gm->getOperand(0) == g)
+      rv = gm->getOperand(1);
+    else if (gm->getOperand(1) == g)
+      rv = gm->getOperand(0);
+    else
+      continue;
+    auto r = Peel(rv, m->ops);
+    if (!BF(r) || Shape(r) != Shape(d)) continue;
+    m->ops.insert(m->ops.end(), {sum, mul, gm});
+    m->inputs = {g, e, d, r};
+    m->outputs = {root->getResult(0)};
+    if (!Escapes(*m)) return m;
+  }
+  return nullptr;
+}
+int Param(mlir::Value v, mlir::Block& block) {
+  for (int depth = 0; depth < 8; ++depth) {
+    if (auto a = mlir::dyn_cast<mlir::BlockArgument>(v))
+      return a.getOwner() == &block ? a.getArgNumber() : -1;
+    MlirOp* o = Owner(v);
+    if (!o) return -1;
+    if (View(o) || Name(o) == "stablehlo.convert") {
+      v = o->getOperand(0);
+      continue;
+    }
+    return -1;
+  }
+  return -1;
+}
+mlir::func::FuncOp Callee(MlirOp* call) {
+  auto ref = call->getAttrOfType<mlir::FlatSymbolRefAttr>("callee");
+  auto module = call->getParentOfType<mlir::ModuleOp>();
+  return ref && module ? module.lookupSymbol<mlir::func::FuncOp>(ref.getValue())
+                       : mlir::func::FuncOp();
+}
+bool Clip(MlirOp* call, bool derivatives) {
+  if (Name(call) != "func.call" || call->getNumOperands() != 3 ||
+      call->getNumResults() != (derivatives ? 3 : 1))
+    return false;
+  auto fn = Callee(call);
+  if (!fn || !fn.getBody().hasOneBlock()) return false;
+  auto& b = fn.getBody().front();
+  auto* ret = b.getTerminator();
+  MlirOp* min = Owner(ret->getOperand(0));
+  if (Name(min) != "stablehlo.minimum") return false;
+  MlirOp* max = Owner(min->getOperand(1));
+  if (Name(max) != "stablehlo.maximum") return false;
+  auto lo = max->getOperand(0), x = max->getOperand(1), hi = min->getOperand(0);
+  int lp = Param(lo, b), hp = Param(hi, b);
+  if (Param(x, b) != 0 || lp < 1 || hp < 1 || lp == hp) return false;
+  bool lower = Const(call->getOperand(lp), -1.e8) ||
+               Const(call->getOperand(lp), -100139008.);
+  bool upper = Const(call->getOperand(hp), 1.e8) ||
+               Const(call->getOperand(hp), 100139008.);
+  if (!lower || !upper) return false;
+  if (!derivatives) return true;
+  // Distinct broadcast nodes must resolve to the same scalar parameter.
+  auto gate = [&](mlir::Value value, bool low) {
+    auto* s = Owner(value);
+    if (Name(s) != "stablehlo.select" || !Const(s->getOperand(1), 1.))
+      return false;
+    auto* gt = Owner(s->getOperand(0));
+    auto* eqsel = Owner(s->getOperand(2));
+    if (Name(gt) != "stablehlo.compare" || Name(eqsel) != "stablehlo.select" ||
+        !Const(eqsel->getOperand(1), .5) || !Const(eqsel->getOperand(2), 0.))
+      return false;
+    auto* eq = Owner(eqsel->getOperand(0));
+    if (Name(eq) != "stablehlo.compare") return false;
+    for (auto* cmp : {gt, eq}) {
+      auto a = cmp->getOperand(0), c = cmp->getOperand(1);
+      if (!BF(a) || !BF(c)) return false;
+      if (low) {
+        if (Param(a, b) != 0 || Param(c, b) != lp) return false;
+      } else if (Param(a, b) != hp || c != max->getResult(0))
+        return false;
+    }
+    std::string t;
+    llvm::raw_string_ostream os(t);
+    gt->getAttr("comparison_direction").print(os);
+    if (t.find("GT") == std::string::npos) return false;
+    t.clear();
+    eq->getAttr("comparison_direction").print(os);
+    return t.find("EQ") != std::string::npos;
+  };
+  return gate(ret->getOperand(1), true) && gate(ret->getOperand(2), false);
+}
+mlir::Value BiasBase(mlir::Value v, std::vector<MlirOp*>& ops,
+                     const std::vector<int64_t>& shape) {
+  MlirOp* o = Owner(v);
+  if (Name(o) != "stablehlo.broadcast_in_dim" ||
+      Attr(o, "broadcast_dimensions") != std::vector<int64_t>{0, 1, 2, 3})
+    return {};
+  auto in = o->getOperand(0);
+  auto s = Shape(in);
+  if (s.size() != 4 || !BF(in)) return {};
+  for (size_t i = 0; i < 4; ++i)
+    if (s[i] != 1 && s[i] != shape[i]) return {};
+  return in;
+}
+bool ClipVjp(MlirOp* call, mlir::Value low, mlir::Value high, mlir::Value dx) {
+  if (Name(call) != "func.call" || call->getNumOperands() != 3 ||
+      call->getNumResults() != 1 || call->getOperand(0) != low ||
+      call->getOperand(1) != high || call->getOperand(2) != dx)
+    return false;
+  auto fn = Callee(call);
+  if (!fn || !fn.getBody().hasOneBlock()) return false;
+  auto& b = fn.getBody().front();
+  if (b.getOperations().size() != 3) return false;
+  MlirOp* outer = Owner(b.getTerminator()->getOperand(0));
+  if (Name(outer) != "stablehlo.multiply" ||
+      outer->getOperand(1) != b.getArgument(0))
+    return false;
+  MlirOp* inner = Owner(outer->getOperand(0));
+  return Name(inner) == "stablehlo.multiply" &&
+         inner->getOperand(0) == b.getArgument(2) &&
+         inner->getOperand(1) == b.getArgument(1);
+}
+void ExtendLogits(RewritePlan* plan) {
+  const char* toggle = std::getenv("METALJAX_EVO_ATTN_LOGITS");
+  if (toggle && std::string(toggle) == "0") return;
+  for (auto& f : plan->evo_attention) {
+    if (f->kind != 0) continue;
+    auto* clip = Owner(f->inputs[0]);
+    const bool derivatives = clip && clip->getNumResults() == 3;
+    if (!Clip(clip, derivatives)) continue;
+    EvoAttentionMatch* back = nullptr;
+    if (derivatives)
+      for (auto& b : plan->evo_attention)
+        if (b->kind == 1 && b->inputs[1] == f->outputs[1]) {
+          back = b.get();
+          break;
+        }
+    if (derivatives && !back) continue;
+    std::vector<MlirOp*> extra{clip};
+    auto raw = clip->getOperand(0);
+    auto* add2 = Owner(raw);
+    if (Name(add2) != "stablehlo.add") continue;
+    auto* add1 = Owner(add2->getOperand(0));
+    if (Name(add1) != "stablehlo.add") continue;
+    auto qk = add1->getOperand(0);
+    if (Name(Owner(qk)) != "stablehlo.dot_general" || !Geometry(qk)) continue;
+    auto mask = BiasBase(add1->getOperand(1), extra, Shape(qk)),
+         bias = BiasBase(add2->getOperand(1), extra, Shape(qk));
+    if (!mask || !bias) continue;
+    extra.push_back(add1);
+    extra.push_back(add2);
+    MlirOp* vjp = nullptr;
+    if (back) {
+      for (MlirOp* u : back->outputs[0].getUsers())
+        if (ClipVjp(u, clip->getResult(1), clip->getResult(2),
+                    back->outputs[0])) {
+          vjp = u;
+          break;
+        }
+      if (!vjp || !back->outputs[0].hasOneUse()) continue;
+      if (!clip->getResult(1).hasOneUse() || !clip->getResult(2).hasOneUse())
+        continue;
+    }
+    EvoAttentionMatch joint = *f;
+    joint.ops.insert(joint.ops.end(), extra.begin(), extra.end());
+    if (back) {
+      joint.ops.insert(joint.ops.end(), back->ops.begin(), back->ops.end());
+      joint.ops.push_back(vjp);
+      joint.outputs.push_back(vjp->getResult(0));
+    }
+    // Escape validation is per original definition time; ports from the later
+    // backward root naturally appear after the forward root.
+    if (Escapes(joint)) continue;
+    f->inputs = {qk, mask, bias};
+    f->logits = true;
+    f->ops.insert(f->ops.end(), extra.begin(), extra.end());
+    if (back) {
+      back->inputs.insert(back->inputs.end(), {qk, mask, bias});
+      back->logits = true;
+      back->ops.push_back(vjp);
+      back->root = vjp;
+      back->outputs = {vjp->getResult(0)};
+    }
+  }
+}
+
+}  // namespace
+void AnalyzeEvoAttention(mlir::func::FuncOp fn, RewritePlan* plan) {
+  const char* enable = std::getenv("METALJAX_EVO_ATTN");
+  if (!enable || std::string(enable) != "1") return;
+  plan->rebuild();
+  llvm::DenseMap<mlir::Value, mlir::Value> fwd;
+  size_t nf = 0, nb = 0;
+  auto accept = [&](std::unique_ptr<EvoAttentionMatch> m) {
+    if (!m) return false;
+    for (MlirOp* o : m->ops)
+      if (plan->skip.contains(o)) return false;
+    if (!EvoAttentionPrepare(Shape(m->inputs[0]).back())) return false;
+    for (MlirOp* o : m->ops) plan->skip.insert(o);
+    plan->evo_attention.push_back(std::move(m));
+    return true;
+  };
+  auto module = fn->getParentOfType<mlir::ModuleOp>();
+  module.walk([&](MlirOp* o) {
+    auto m = Forward(o);
+    if (m) {
+      auto e = m->outputs[1], d = m->outputs[2];
+      if (accept(std::move(m))) {
+        fwd[e] = d;
+        ++nf;
+      }
+    }
+  });
+  module.walk([&](MlirOp* o) {
+    if (accept(Backward(o, fwd))) ++nb;
+  });
+  ExtendLogits(plan);
+  size_t logits = 0;
+  for (auto& m : plan->evo_attention) logits += m->logits;
+  if (std::getenv("METALJAX_DEBUG"))
+    std::fprintf(
+        stderr,
+        "[metaljax-native] evo-attn: forward=%zu backward=%zu logits=%zu\n", nf,
+        nb, logits);
+}
+}  // namespace metaljax
