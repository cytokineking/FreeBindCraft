@@ -0,0 +1,158 @@
+"""Differential tests of the opt-in bounded Evoformer forward/backward path.
+
+Run against the development wheel. Each arm is a fresh process; enabled tests
+must demonstrate recognition and successful execution, not a silent fallback.
+"""
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+import numpy as np
+import pytest
+
+
+def _worker(destination):
+    import jax
+    import jax.numpy as jnp
+    cases = [dict(name=f'n{n}', n=n) for n in [65, 127, 128, 129, 146, 185, 255, 257, 512]]
+    cases += [dict(name='msa8', n=146, h=8, d=32),
+              dict(name='broadcast', n=129, mask='head', bias='query'),
+              dict(name='layout', n=146, layout=True),
+              dict(name='remat_scan', n=129, remat=True),
+              dict(name='large_logits', n=146, scale=1e4),
+              dict(name='zeros', n=146, scale=0.),
+              dict(name='clip_ties', n=129, scale=0., ties=True),
+              dict(name='nonfinite', n=146, nonfinite=True),
+              dict(name='fallback37', n=37, fused=False),
+              dict(name='fallback64', n=64, fused=False),
+              dict(name='fallback513', n=513, fused=False),
+              dict(name='fallback_heads', n=146, h=3, fused=False),
+              dict(name='fallback_fp32', n=146, fp32=True, fused=False),
+              dict(name='escaped_max', n=146, escape=True, fused=False),
+              dict(name='nonzero_init', n=146, init=.125, fused=False)]
+    saved,metadata={},[]
+    for ci,c in enumerate(cases):
+        print('FBC_CASE '+c['name'],file=sys.stderr,flush=True)
+        rng=np.random.default_rng(900+ci)
+        b,q,h,d,n=2,19,c.get('h',4),c.get('d',16),c['n']
+        scale=c.get('scale',1.)
+        qa=rng.normal(size=(b,q,h,d)).astype(np.float32)*scale
+        ka=rng.normal(size=(b,n,h,d)).astype(np.float32)*scale
+        va=rng.normal(size=(b,n,h,d)).astype(np.float32)
+        bs=(1,h,q,1) if c.get('bias')=='query' else (1,h,q,n)
+        bias=rng.normal(size=bs).astype(np.float32)
+        ms=(1,h,1,n) if c.get('mask')=='head' else (b,1,1,n)
+        mask=np.zeros(ms,np.float32);mask[..., -3:]=-1e9
+        if c.get('ties'):
+            bias[:]=0.;bias[:,:,0,:]=-100139008.;bias[:,:,1,:]=100139008.;mask[:]=0.
+        if ms[0]==b:mask[1]=-1e9  # exact baseline semantics of fully masked rows
+        if c.get('nonfinite'):qa[0,0,0,0]=np.nan;qa[0,1,1,0]=np.inf
+        weight=rng.normal(size=(b,q,h,d)).astype(np.float32)
+        dtype=jnp.float32 if c.get('fp32') else jnp.bfloat16
+        def body(qa,ka,va,bias,mask):
+            qa,ka,va,bias,mask=[x.astype(dtype) for x in (qa,ka,va,bias,mask)]
+            if c.get('layout'):
+                qa=jnp.swapaxes(qa,1,2);qa=jnp.swapaxes(qa,1,2)
+                ka=jnp.flip(ka,axis=1);va=jnp.flip(va,axis=1)
+            qa=qa*jnp.asarray(d**-.5,dtype)
+            logits=jnp.einsum('bqhd,bkhd->bhqk',qa,ka)
+            logits=jnp.clip((logits+mask)+bias,-1e8,1e8)
+            maximum=jax.lax.stop_gradient(jnp.max(logits,-1,keepdims=True))
+            e=jnp.exp(logits-maximum)
+            if c.get('init'):
+                den=jax.lax.reduce(e.astype(jnp.float32),jnp.float32(c['init']),jax.lax.add,(3,))[...,None].astype(dtype)
+            else:den=jnp.sum(e.astype(jnp.float32),-1,keepdims=True).astype(dtype)
+            out=jnp.einsum('bkhd,bhqk->bqhd',va,e/den)
+            return out,maximum
+        def loss(qa,ka,va,bias,mask):
+            if c.get('remat'):
+                step=jax.checkpoint(body)
+                def loop(i,acc):
+                    out,_=step(qa+jnp.float32(i)*.001,ka,va,bias,mask)
+                    return acc+out.astype(jnp.float32)
+                out=jax.lax.fori_loop(0,3,loop,jnp.zeros((b,q,h,d),jnp.float32))
+                maximum=jnp.zeros((1,),jnp.float32)
+            else:out,maximum=body(qa,ka,va,bias,mask)
+            aux=(out,maximum) if c.get('escape') else (out,)
+            return jnp.sum(out.astype(jnp.float32)*weight),aux
+        fn=jax.jit(jax.value_and_grad(loss,argnums=(0,1,2,3,4),has_aux=True))
+        for changed in [0,1]:
+            args=[qa,ka,va,bias,mask]
+            if changed:args=[qa*.875+.03,ka*1.125,va*.9,bias+.25,mask]
+            result=jax.tree_util.tree_map(lambda x:np.asarray(x).astype(np.float32),fn(*args))
+            leaves=jax.tree_util.tree_leaves(result)
+            for i,a in enumerate(leaves):saved[f'{c["name"]}_{changed}_{i}']=a
+        metadata.append(dict(name=c['name'],fused=c.get('fused',True),nonfinite=c.get('nonfinite',False)))
+    np.savez(destination,**saved)
+    Path(str(destination)+'.json').write_text(json.dumps(metadata))
+
+
+@pytest.fixture(scope='module')
+def comparisons(tmp_path_factory):
+    if sys.platform!='darwin':pytest.skip('Metal development backend required')
+    directory=tmp_path_factory.mktemp('evo-attention')
+    reports=[]
+    for mode in ['0','1']:
+        env=dict(os.environ,JAX_PLATFORMS='metal',METALJAX_DEBUG='1',METALJAX_EVO_ATTN=mode,
+                 METALJAX_MATMUL_PRECISION='high')
+        for key in ['FBC_ATTN_PROFILE','FBC_PROFILE_ACTIVE','METALJAX_EVO_ATTN_KERNEL','METALJAX_EVO_ATTN_LOGITS']:env.pop(key,None)
+        path=directory/(mode+'.npz')
+        result=subprocess.run([sys.executable,__file__,'--worker',str(path)],env=env,
+                              capture_output=True,text=True,timeout=180)
+        (directory/(mode+'.log')).write_text(result.stdout+result.stderr)
+        assert result.returncode==0,result.stderr[-5000:]
+        reports.append((path,result.stderr))
+    return directory,reports
+
+
+def test_attention_forward_and_all_derivatives(comparisons):
+    _,reports=comparisons
+    metadata=json.loads(Path(str(reports[0][0])+'.json').read_text())
+    with np.load(reports[0][0]) as baseline,np.load(reports[1][0]) as candidate:
+        for c in metadata:
+            if not c['fused'] or c['nonfinite']:continue
+            for key in baseline.files:
+                if key.startswith(c['name']+'_'):
+                    assert candidate[key].tobytes()==baseline[key].tobytes(),key
+                    np.testing.assert_array_equal(candidate[key],baseline[key],err_msg=key)
+
+
+def test_nonfinite_and_fully_masked_semantics(comparisons):
+    _,reports=comparisons
+    with np.load(reports[0][0]) as baseline,np.load(reports[1][0]) as candidate:
+        for key in baseline.files:
+            if key.startswith('nonfinite_'):
+                np.testing.assert_array_equal(candidate[key],baseline[key],err_msg=key)
+
+
+def test_unsupported_cases_remain_literal(comparisons):
+    _,reports=comparisons
+    metadata=json.loads(Path(str(reports[0][0])+'.json').read_text())
+    segments=dict(re.findall(r'FBC_CASE (\S+)\n(.*?)(?=FBC_CASE |\Z)',reports[1][1],re.S))
+    with np.load(reports[0][0]) as baseline,np.load(reports[1][0]) as candidate:
+        for c in metadata:
+            if c['fused']:continue
+            assert not re.search(r'evo-attn: forward=[1-9]',segments[c['name']]),c['name']
+            for key in baseline.files:
+                if key.startswith(c['name']+'_'):
+                    assert candidate[key].tobytes()==baseline[key].tobytes(),key
+                    np.testing.assert_array_equal(candidate[key],baseline[key],err_msg=key)
+
+
+def test_kernels_execute_without_retirement(comparisons):
+    _,reports=comparisons
+    metadata=json.loads(Path(str(reports[0][0])+'.json').read_text())
+    segments=dict(re.findall(r'FBC_CASE (\S+)\n(.*?)(?=FBC_CASE |\Z)',reports[1][1],re.S))
+    for c in metadata:
+        if c['fused']:
+            text=segments[c['name']]
+            assert re.search(r'evo-attn: forward=[1-9]\d* backward=[1-9]',text),c['name']
+            assert 'no fused tape' not in text,c['name']
+            assert 'compiled native tape failed' not in text,c['name']
+            assert 'compiled body failed' not in text,c['name']
+
+
+if __name__=='__main__' and sys.argv[1:2]==['--worker']:_worker(Path(sys.argv[2]))
