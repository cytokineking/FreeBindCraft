diff --git a/plugin-native/runtime/evo_attention.cc b/plugin-native/runtime/evo_attention.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6f03cdb99e0f7698d35925e1fd99c5644663696b
--- /dev/null
+++ b/plugin-native/runtime/evo_attention.cc
@@ -0,0 +1,201 @@
+// FreeBindCraft opt-in attention softmax epilogues. Explicit BF16 arithmetic
+// and the frozen MLX row-reduction order, including the BF16 AD reduction.
+#include "evo_attention.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <sstream>
+namespace metaljax {
+namespace {
+struct Built {
+  bool ok = false;
+  mx::fast::CustomKernelFunction f, b, lf, lb;
+};
+std::mutex mu;
+std::map<int64_t, Built> cache;
+bool Kernel() {
+  const char* s = std::getenv("METALJAX_EVO_ATTN_KERNEL");
+  return !s || std::string(s) != "0";
+}
+std::string Source(int64_t n, bool back, bool logits = false) {
+  std::ostringstream s;
+  s << "const uint lane=thread_index_in_simdgroup;\nconst uint "
+       "row=threadgroup_position_in_grid.x;\nconst uint N="
+    << n << ";\nconst uint base=row*N;\n";
+  if (logits)
+    s << "const uint qdim=x_shape[2],hdim=x_shape[1];const uint "
+         "qb=row%qdim,hb=(row/qdim)%hdim,bb=row/(qdim*hdim);\n"
+      << "const uint "
+         "mo=(mask_shape[0]==1?0:bb)*mask_strides[0]+(mask_shape[1]==1?0:hb)*"
+         "mask_strides[1]+(mask_shape[2]==1?0:qb)*mask_strides[2];\n"
+      << "const uint "
+         "bo=(bias_shape[0]==1?0:bb)*bias_strides[0]+(bias_shape[1]==1?0:hb)*"
+         "bias_strides[1]+(bias_shape[2]==1?0:qb)*bias_strides[2];\n"
+      << "const bfloat16_t lo=bfloat16_t(-1.0e8f),hi=bfloat16_t(1.0e8f);\n";
+  const std::string raw =
+      "bfloat16_t "
+      "raw=(x[base+i]+mask[mo+(mask_shape[3]==1?0:i)*mask_strides[3]])+bias[bo+"
+      "(bias_shape[3]==1?0:i)*bias_strides[3]];";
+  if (!back) {
+    s << "float mx=-INFINITY;bool nan=false;\n";
+    s << "bfloat16_t values[" << ((n + 127) / 128) * 4 << "],exps["
+      << ((n + 127) / 128) * 4 << "];\n";
+    s << "for(uint block=0;block<" << (n + 127) / 128
+      << ";++block)for(uint j=0;j<4;++j){uint t=block*4+j;uint "
+         "i=block*128+lane*4+j;if(i<N){"
+      << (logits ? raw +
+                       "bfloat16_t "
+                       "mid=isnan(float(raw))?raw:max(lo,raw);values[t]=isnan("
+                       "float(mid))?mid:min(hi,mid);"
+                 : "values[t]=x[base+i];")
+      << "float v=float(values[t]);nan=nan||isnan(v);mx=max(mx,v);}}\n";
+    s << "mx=simd_max(mx);if(simd_any(nan))mx=NAN;float sum=0.0f;\n";
+    s << "for(uint block=0;block<" << (n + 127) / 128
+      << ";++block)for(uint j=0;j<4;++j){uint t=block*4+j;uint "
+         "i=block*128+lane*4+j;if(i<N){bfloat16_t "
+         "z=values[t]-bfloat16_t(mx);exps[t]=metal::precise::exp(z);sum=float("
+         "exps[t])+sum;}}\n";
+    s << "bfloat16_t den=bfloat16_t(simd_sum(sum));if(lane==0)d[row]=den;\n";
+    s << "for(uint block=0;block<" << (n + 127) / 128
+      << ";++block)for(uint j=0;j<4;++j){uint t=block*4+j;uint "
+         "i=block*128+lane*4+j;if(i<N){e[base+i]=exps[t];p[base+i]=exps[t]/"
+         "den;}}\n";
+  } else {
+    s << "bfloat16_t den=d[row],inv=r[row],total=bfloat16_t(0);\n";
+    s << "bfloat16_t gs[" << ((n + 127) / 128) * 4 << "],es["
+      << ((n + 127) / 128) * 4 << "];\n";
+    s << "for(uint block=0;block<" << (n + 127) / 128
+      << ";++block)for(uint j=0;j<4;++j){uint t=block*4+j;uint "
+         "i=block*128+lane*4+j;if(i<N){gs[t]=g[base+i];es[t]=e[base+i];"
+         "bfloat16_t a=gs[t]*inv;bfloat16_t v=a*es[t];total=v+total;}}\n";
+    s << "bfloat16_t red=simd_sum(total);red=red+bfloat16_t(0);bfloat16_t "
+         "neg=bfloat16_t(float(-red)+0.0f);\n";
+    s << "for(uint block=0;block<" << (n + 127) / 128
+      << ";++block)for(uint j=0;j<4;++j){uint t=block*4+j;uint "
+         "i=block*128+lane*4+j;if(i<N){bfloat16_t div=gs[t]/den;bfloat16_t "
+         "a=div+neg;"
+      << (logits ? raw +
+                       "bfloat16_t "
+                       "mid=isnan(float(raw))?raw:max(lo,raw);bfloat16_t "
+                       "lg=raw>lo?bfloat16_t(1):(raw==lo?bfloat16_t(.5f):"
+                       "bfloat16_t(0));bfloat16_t "
+                       "hg=hi>mid?bfloat16_t(1):(hi==mid?bfloat16_t(.5f):"
+                       "bfloat16_t(0));bfloat16_t dx=a*es[t];bfloat16_t "
+                       "clipped=dx*hg;out[base+i]=clipped*lg;"
+                 : "out[base+i]=a*es[t];")
+      << "}}\n";
+  }
+  return s.str();
+}
+std::vector<mx::array> Launch(const Built& b, const std::vector<mx::array>& xs,
+                              bool back, bool logits = false) {
+  auto sh = xs[0].shape(), row = sh;
+  row.back() = 1;
+  int count = xs[0].size() / sh.back();
+  std::vector<mx::Shape> shapes =
+      back ? std::vector<mx::Shape>{sh} : std::vector<mx::Shape>{sh, sh, row};
+  return (back ? (logits ? b.lb : b.b) : (logits ? b.lf : b.f))(
+      xs, shapes, std::vector<mx::Dtype>(shapes.size(), mx::bfloat16),
+      {count * 32, 1, 1}, {32, 1, 1}, {}, std::nullopt, false, {});
+}
+Built GetBuilt(int64_t n) {
+  std::lock_guard<std::mutex> lock(mu);
+  return cache.at(n);
+}
+std::vector<mx::array> LiteralForward(const mx::array& x) {
+  auto max = mx::maximum(mx::array(-INFINITY, x.dtype()),
+                         mx::max(x, std::vector<int>{3}, true));
+  auto e = mx::exp(mx::subtract(x, max));
+  auto d =
+      mx::astype(mx::sum(mx::astype(e, mx::float32), std::vector<int>{3}, true),
+                 x.dtype());
+  return {mx::divide(e, d), e, d};
+}
+mx::array LiteralBackward(const std::vector<mx::array>& xs) {
+  const auto& g = xs[0];
+  const auto& e = xs[1];
+  const auto& d = xs[2];
+  const auto& r = xs[3];
+  auto t = mx::multiply(mx::multiply(g, r), e);
+  auto red = mx::add(mx::sum(t, std::vector<int>{3}, true),
+                     mx::array(0.0f, mx::bfloat16));
+  auto neg = mx::astype(mx::add(mx::astype(mx::negative(red), mx::float32),
+                                mx::array(0.0f, mx::float32)),
+                        mx::bfloat16);
+  return mx::multiply(mx::add(mx::divide(g, d), neg), e);
+}
+}  // namespace
+bool EvoAttentionPrepare(int64_t n) {
+  if (n < 65 || n > 512) return false;
+  if (!Kernel()) return true;
+  std::lock_guard<std::mutex> lock(mu);
+  if (cache.count(n)) return cache.at(n).ok;
+  Built b;
+  try {
+    b.f = mx::fast::metal_kernel("fbc_evo_fwd_n" + std::to_string(n), {"x"},
+                                 {"p", "e", "d"}, Source(n, false));
+    b.b =
+        mx::fast::metal_kernel("fbc_evo_bwd_n" + std::to_string(n),
+                               {"g", "e", "d", "r"}, {"out"}, Source(n, true));
+    b.lf = mx::fast::metal_kernel("fbc_evo_logits_fwd_n" + std::to_string(n),
+                                  {"x", "mask", "bias"}, {"p", "e", "d"},
+                                  Source(n, false, true));
+    b.lb = mx::fast::metal_kernel("fbc_evo_logits_bwd_n" + std::to_string(n),
+                                  {"g", "e", "d", "r", "x", "mask", "bias"},
+                                  {"out"}, Source(n, true, true));
+    auto x = mx::zeros({1, 4, 8, (int)n}, mx::bfloat16),
+         one = mx::ones({1, 4, 8, 1}, mx::bfloat16);
+    auto f = Launch(b, {x}, false);
+    mx::eval(f);
+    mx::eval(Launch(b, {x, f[1], one, one}, true));
+    auto mask = mx::zeros({1, 1, 1, (int)n}, mx::bfloat16);
+    mx::eval(Launch(b, {x, mask, x}, false, true));
+    mx::eval(Launch(b, {x, f[1], one, one, x, mask, x}, true, true));
+    b.ok = true;
+    if (std::getenv("METALJAX_DEBUG"))
+      std::fprintf(stderr, "[metaljax-native] evo-attn: kernels ready N=%lld\n",
+                   (long long)n);
+  } catch (const std::exception& ex) {
+    if (is_oom(ex)) throw;
+    if (std::getenv("METALJAX_DEBUG"))
+      std::fprintf(stderr,
+                   "[metaljax-native] evo-attn: kernel declined N=%lld (%s)\n",
+                   (long long)n, ex.what());
+  }
+  cache.emplace(n, b);
+  return b.ok;
+}
+std::vector<mx::array> EvoAttentionForward(const std::vector<mx::array>& xs,
+                                           bool logits) {
+  if (!Kernel()) {
+    auto x = xs[0];
+    if (logits)
+      x = mx::minimum(mx::array(1.e8f, mx::bfloat16),
+                      mx::maximum(mx::array(-1.e8f, mx::bfloat16),
+                                  mx::add(mx::add(x, xs[1]), xs[2])));
+    return LiteralForward(x);
+  }
+  return Launch(GetBuilt(xs[0].shape(-1)), xs, false, logits);
+}
+mx::array EvoAttentionBackward(const std::vector<mx::array>& xs, bool logits) {
+  if (!Kernel()) {
+    auto dx = LiteralBackward({xs[0], xs[1], xs[2], xs[3]});
+    if (!logits) return dx;
+    auto raw = mx::add(mx::add(xs[4], xs[5]), xs[6]);
+    auto lo = mx::array(-1.e8f, mx::bfloat16),
+         hi = mx::array(1.e8f, mx::bfloat16),
+         one = mx::array(1.f, mx::bfloat16),
+         half = mx::array(.5f, mx::bfloat16),
+         zero = mx::array(0.f, mx::bfloat16);
+    auto mid = mx::maximum(lo, raw);
+    auto lg = mx::where(mx::greater(raw, lo), one,
+                        mx::where(mx::equal(raw, lo), half, zero));
+    auto hg = mx::where(mx::greater(hi, mid), one,
+                        mx::where(mx::equal(hi, mid), half, zero));
+    return mx::multiply(mx::multiply(dx, hg), lg);
+  }
+  return Launch(GetBuilt(xs[0].shape(-1)), xs, true, logits)[0];
+}
+}  // namespace metaljax
