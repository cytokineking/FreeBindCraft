+// Diagnostic-only GPU fences for FreeBindCraft attention profiling.
+#pragma once
+#include "program.h"
+#include <mlx/backend/metal/metal.h>
+namespace metaljax {
+struct AttentionProfileRegion {mx::metal::DispatchStats before;bool overlap=false;};
+bool AttentionProfileEnabled();
+mx::array AttentionProfileMark(const std::vector<mx::array>&,const std::string&,bool,const std::shared_ptr<AttentionProfileRegion>&);
+std::string AttentionProfileLabel(const Entry&,const std::vector<std::optional<mx::array>>&);
